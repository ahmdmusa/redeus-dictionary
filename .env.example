# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# GEMINI_TTS_API_KEY: Required for Gemini Text-to-Speech pronunciation audio.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_TTS_API_KEY=MY_GEMINI_TTS_API_KEY

# PEXELS_API_KEY: Required for Pexels real photo image search.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
PEXELS_API_KEY=MY_PEXELS_API_KEY

# OPENROUTER_API_KEY: Fallback free-model AI provider when Gemini hits quota or fails.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
OPENROUTER_API_KEY=MY_OPENROUTER_API_KEY

